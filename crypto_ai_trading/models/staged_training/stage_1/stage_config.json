{
  "stage": 1,
  "stage_info": {
    "name": "Returns Only",
    "description": "\u041e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u043e\u0432",
    "task_weights": {
      "returns": 1.0,
      "directions": 0.0,
      "levels": 0.0,
      "risk": 0.0
