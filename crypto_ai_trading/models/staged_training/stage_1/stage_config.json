        "future_return_12h",
        "direction_15m",
        "direction_1h",
        "direction_4h",
        "direction_12h",
        "will_reach_long_1pct_4h",
        "will_reach_long_2pct_4h",
        "will_reach_long_1pct_12h",
        "will_reach_long_2pct_12h",
        "will_reach_short_1pct_4h",
        "will_reach_short_2pct_4h",
        "will_reach_short_1pct_12h",
        "will_reach_short_2pct_12h",
        "max_drawdown_1h",
        "max_rally_1h",
        "max_drawdown_4h",
        "max_rally_4h"
      ]
    },
    "loss": {
      "task_weights": {
        "returns": 1.0,
        "directions": 0.0,
        "levels": 0.0,
        "risk": 0.0
      },
      "class_weights": [
        2.0,
        2.0,
        1.0
      ],
      "use_weighted_sampling": false,
      "use_focal_loss": false,
      "adaptive_class_weights": false,
      "use_dynamic_class_weights": false,
