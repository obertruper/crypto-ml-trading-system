          "name": "sma",
          "periods": [
            10,
            20,
            50
          ]
        },
        {
          "name": "ema",
          "periods": [
            12,
            26,
            50
          ]
        },
        {
          "name": "rsi",
          "period": 14
        },
        {
          "name": "macd",
          "fast": 12,
          "slow": 26,
          "signal": 9
        },
        {
          "name": "bollinger_bands",
          "period": 20,
