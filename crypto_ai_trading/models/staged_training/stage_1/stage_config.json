      "compile_model": false,
      "use_anti_collapse": false,
      "temperature_scaling": false,
      "use_symbol_embedding": false,
      "lr_scheduler": {
        "type": "cosine",
        "min_lr": "1e-6",
        "warmup_epochs": 3
