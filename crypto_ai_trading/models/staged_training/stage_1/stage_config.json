      "symbols": [
        "BTCUSDT",
        "ETHUSDT",
        "BNBUSDT",
        "SOLUSDT",
        "XRPUSDT",
        "ADAUSDT",
        "DOGEUSDT",
        "DOTUSDT",
        "LINKUSDT",
        "LTCUSDT",
        "UNIUSDT",
        "AVAXUSDT"
