# MCP Server Environment Variables

# GitHub Token (уже настроен через gh auth)
GITHUB_TOKEN=${GITHUB_TOKEN}

# Brave Search API (получите на https://api.search.brave.com/)
BRAVE_API_KEY=your_brave_api_key_here

# PostgreSQL (уже настроено в connection string)
# DATABASE_URL=postgresql://ruslan@localhost:5555/crypto_trading

# Puppeteer настройки
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000

# Memory server настройки
MEMORY_MAX_SIZE=1000
MEMORY_PERSISTENCE_PATH=/Users/ruslan/PycharmProjects/LLM TRANSFORM/crypto_ai_trading/.mcp_memory